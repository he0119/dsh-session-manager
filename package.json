{
  "name": "@he0119/dsh-session-manager",
  "version": "0.7.2",
  "description": "DSH 的会话管理插件：在侧栏的「会话管理」页里把会话迁到新目录、导出/导入 .dshsess 包、归档与删除，并用 WebDAV 在多台机器之间同步。",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "icon": "./icon.svg",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": "^0.2.0-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  },
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('lib', { recursive: true, force: true })\"",
    "build": "tsdown --concurrency 1",
    "build:host": "tsdown --filter @he0119/dsh-session-manager/host",
    "build:client": "tsdown --filter @he0119/dsh-session-manager/client",
    "build:types": "tsdown --filter @he0119/dsh-session-manager/types",
    "watch": "tsdown --watch --concurrency 1",
    "typecheck": "tsc -p tsconfig.test.json && tsc -p tsconfig.client.json",
    "prepublishOnly": "tsdown --concurrency 1",
    "test": "node test/run-all.mjs",
    "test:runner": "node --test",
    "check:package": "node scripts/check-package.mjs",
    "check": "tsc -p tsconfig.test.json && node test/run-all.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "workspace",
    "migration",
    "session",
    "relocate"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/he0119/dsh-session-manager.git"
  },
  "homepage": "https://github.com/he0119/dsh-session-manager",
  "bugs": {
    "url": "https://github.com/he0119/dsh-session-manager/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.1",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-client-locale": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.1",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.31",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "fzstd": "^0.1.1"
  }
}
